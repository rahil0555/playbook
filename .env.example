# Copy to .env.local and fill in on YOUR machine only. .env.local and .env* are git-ignored.
# Never put a real key in this file, in code, in docs, or in chat.

# Edu's ElevenLabs voice. SERVER-ONLY: there is deliberately no VITE_ prefix, so Vite can never inline either of
# these into the browser bundle. They are read by api/voice.ts (the Vercel serverless function) and by
# scripts/generate-voice.ts. Set them in the Vercel project settings for the deployed app.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: the ElevenLabs model. Defaults to eleven_multilingual_v2.
ELEVENLABS_MODEL_ID=

# Used only by the older voice-audition tool in scripts/voice (not by the app).
OPENAI_API_KEY=
