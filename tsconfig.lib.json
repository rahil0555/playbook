{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false,
    "outDir": "./dist-lib/types",
    "rootDir": "./src/playlab",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": ["src/playlab"],
  "exclude": ["src/playlab/**/*.test.ts", "src/playlab/**/*.test.tsx", "src/playlab/test"]
}
